<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ImmersiveVoice</AssemblyName>
    <Version>2.12.0</Version>
    <Authors>ZombiesYard</Authors>
    <Copyright>Copyright (C) 2026 ZombiesYard</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ZombiesYard/ImmersiveVoice</RepositoryUrl>
    <Deterministic>true</Deterministic>
    <GameRoot Condition="'$(GameRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..</GameRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="mscorlib" HintPath="$(GameRoot)/EscapeFromTarkov_Data/Managed/mscorlib.dll" Private="false" />
    <Reference Include="System" HintPath="$(GameRoot)/EscapeFromTarkov_Data/Managed/System.dll" Private="false" />
    <Reference Include="System.Core" HintPath="$(GameRoot)/EscapeFromTarkov_Data/Managed/System.Core.dll" Private="false" />
    <Reference Include="netstandard" HintPath="$(GameRoot)/EscapeFromTarkov_Data/Managed/netstandard.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(GameRoot)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameRoot)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameRoot)/EscapeFromTarkov_Data/Managed/Assembly-CSharp.dll" Private="false" />
    <Reference Include="ItemComponent.Types" HintPath="$(GameRoot)/EscapeFromTarkov_Data/Managed/ItemComponent.Types.dll" Private="false" />
    <Reference Include="Comfort" HintPath="$(GameRoot)/EscapeFromTarkov_Data/Managed/Comfort.dll" Private="false" />
    <Reference Include="Sirenix.Serialization" HintPath="$(GameRoot)/EscapeFromTarkov_Data/Managed/Sirenix.Serialization.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameRoot)/EscapeFromTarkov_Data/Managed/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameRoot)/EscapeFromTarkov_Data/Managed/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(GameRoot)/EscapeFromTarkov_Data/Managed/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(GameRoot)/EscapeFromTarkov_Data/Managed/UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(GameRoot)/EscapeFromTarkov_Data/Managed/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="DissonanceVoip" HintPath="$(GameRoot)/EscapeFromTarkov_Data/Managed/DissonanceVoip.dll" Private="false" />
  </ItemGroup>
</Project>
