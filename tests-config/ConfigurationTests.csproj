<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <GameRoot Condition="'$(GameRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..</GameRoot>
    <FrameworkRoot Condition="'$(FrameworkRoot)' == ''">$(SystemRoot)/Microsoft.NET/Framework64/v4.0.30319</FrameworkRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/Settings.cs" Link="Settings.cs" />
    <Compile Include="../src/MenuCatalog.cs" Link="MenuCatalog.cs" />
    <Compile Include="../src/ConfigurationMenu.cs" Link="ConfigurationMenu.cs" />
    <Compile Include="../src/SemanticVoice.cs" Link="SemanticVoice.cs" />
    <None Update="legacy-settings.tsv" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="mscorlib" HintPath="$(FrameworkRoot)/mscorlib.dll" />
    <Reference Include="System" HintPath="$(FrameworkRoot)/System.dll" />
    <Reference Include="System.Core" HintPath="$(FrameworkRoot)/System.Core.dll" />
    <Reference Include="BepInEx" HintPath="$(GameRoot)/BepInEx/core/BepInEx.dll" />
    <Reference Include="UnityEngine" HintPath="$(GameRoot)/EscapeFromTarkov_Data/Managed/UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameRoot)/EscapeFromTarkov_Data/Managed/UnityEngine.CoreModule.dll" />
  </ItemGroup>
</Project>
